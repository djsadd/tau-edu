# Адреса сервисов лежат в переменных: nginx разрешает их при каждом запросе,
# поэтому шлюз запускается без остальных контейнеров и замечает их перезапуск.
resolver 127.0.0.11 valid=10s ipv6=off;

map $http_upgrade $connection_upgrade {
  default upgrade;
  ""      "";
}

map $http_x_forwarded_proto $forwarded_proto {
  default $http_x_forwarded_proto;
  ""      $scheme;
}

server {
  listen 8080;
  server_tokens off;
  client_max_body_size 4m;

  set_real_ip_from ${TRUSTED_PROXY};
  real_ip_header X-Forwarded-For;
  real_ip_recursive on;

  proxy_http_version 1.1;
  proxy_set_header Host $http_host;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $connection_upgrade;
  # Заменяем, а не дополняем: по этому адресу считаются лимиты, клиент не должен его подделать.
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Forwarded-Host $http_host;
  proxy_set_header X-Forwarded-Proto $forwarded_proto;

  location = /healthz {
    default_type text/plain;
    return 200 "ok\n";
  }

  location = /api/search {
    set $upstream http://search:4001;
    proxy_pass $upstream;
  }

  location = /api/chat {
    set $upstream http://assistant:4002;
    proxy_pass $upstream;
    # Ответ помощника приходит по частям и не должен копиться в буфере.
    proxy_buffering off;
    proxy_read_timeout 300s;
  }

  location = /api/apply {
    set $upstream http://admissions:4004;
    proxy_pass $upstream;
  }

  location = /api/admin/files {
    set $upstream http://files:4003;
    proxy_pass $upstream;
    client_max_body_size 200m;
    proxy_request_buffering off;
    proxy_read_timeout 300s;
  }

  location ~ ^/files/[0-9a-fA-F-]+$ {
    set $upstream http://files:4003;
    proxy_pass $upstream;
    proxy_buffering off;
  }

  location = /api/health { return 404; }
  location ^~ /internal/ { return 404; }

  location = /unavailable.html {
    internal;
    root /usr/share/nginx/html;
  }

  location / {
    set $upstream http://${WEB_UPSTREAM};
    proxy_pass $upstream;
    proxy_intercept_errors on;
    error_page 502 503 504 /unavailable.html;
  }
}
