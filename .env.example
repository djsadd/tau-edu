# Заполнить секреты случайными значениями: ./scripts/init-env.sh

# Публичный адрес сайта: sitemap, canonical. С https:// cookie сессии получает флаг Secure.
SITE_URL=http://localhost:3000

# Где шлюз слушает на хосте. Чтобы открыть наружу: 0.0.0.0:80
GATEWAY_BIND=127.0.0.1:3000

# Адрес внешнего прокси с HTTPS, если он стоит перед шлюзом. Только от него шлюз примет X-Forwarded-For.
TRUSTED_PROXY=127.0.0.1/32

# PostgreSQL: владелец базы (миграции)
POSTGRES_PASSWORD=
# Отдельные роли сервисов
DB_PASSWORD_WEB=
DB_PASSWORD_SEARCH=
DB_PASSWORD_FILES=
DB_PASSWORD_ADMISSIONS=
DB_PASSWORD_ASSISTANT=

# Вызовы между сервисами
INTERNAL_TOKEN=

# Подпись сессий панели
SESSION_SECRET=

# Первый администратор
ADMIN_EMAIL=admin@example.edu.kz
ADMIN_PASSWORD=

# ИИ-помощник. Без ключа чат отвечает ссылками из поиска по сайту.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5

# Только для npm run dev и npm run db:* вне контейнеров
DATABASE_URL=
